# Copy this file to `.env` (or export the lines from your shell rc) and fill in
# the values. Never commit a real `.env` — it's in .gitignore.

# ── AWS (always required) ────────────────────────────────────────────────────

# A read-only IAM user is recommended; promote to a write-capable role only
# when you actually want OpenKite to mutate AWS.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=my-readonly-profile     # use a named profile instead

# ── LLM provider (pick ONE) ──────────────────────────────────────────────────
# Set OPENKITE_PROVIDER + the provider's API key. Override the model with
# OPENKITE_MODEL — or use the combined form `provider:model` and skip
# OPENKITE_PROVIDER. Run `openkite providers` to list every option.

# Default: Anthropic (Claude Haiku 4.5)
ANTHROPIC_API_KEY=sk-ant-...
# OPENKITE_PROVIDER=anthropic
# OPENKITE_MODEL=claude-sonnet-4-6

# OpenAI — requires `pip install 'cloudops-openkite[openai]'`
# OPENKITE_PROVIDER=openai
# OPENKITE_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...

# Google Gemini — requires `pip install 'cloudops-openkite[google]'`
# OPENKITE_PROVIDER=google
# OPENKITE_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=...

# Mistral — requires `pip install 'cloudops-openkite[mistral]'`
# OPENKITE_PROVIDER=mistral
# OPENKITE_MODEL=mistral-large-latest
# MISTRAL_API_KEY=...

# Groq — requires `pip install 'cloudops-openkite[groq]'`
# OPENKITE_PROVIDER=groq
# OPENKITE_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=...

# Qwen via Alibaba DashScope — requires `pip install 'cloudops-openkite[qwen]'`
# OPENKITE_PROVIDER=qwen
# OPENKITE_MODEL=qwen3-coder-plus
# DASHSCOPE_API_KEY=...

# OpenRouter (any model on the catalog) — uses the `[openai]` extra
# OPENKITE_PROVIDER=openrouter
# OPENKITE_MODEL=anthropic/claude-haiku-4.5
# OPENROUTER_API_KEY=...

# Ollama (local, no API key) — requires `pip install 'cloudops-openkite[ollama]'`
# OPENKITE_PROVIDER=ollama
# OPENKITE_MODEL=llama3.1

# ── Storage ──────────────────────────────────────────────────────────────────

# SQLite path for thread checkpoints. Default: checkpoints/openkite.db
# OPENKITE_DB=checkpoints/openkite.db
