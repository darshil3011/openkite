# Copy this file to `.env` (or export the lines from your shell rc) and fill in
# the values. Never commit a real `.env` — it's in .gitignore.

# ── Required ─────────────────────────────────────────────────────────────────

# Anthropic API key for the LLM router. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# AWS credentials. A read-only IAM user is recommended; promote to a
# write-capable role only when you actually want openkite to mutate AWS.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ── Optional ─────────────────────────────────────────────────────────────────

# Default region for tool calls. Override per-query by mentioning a region in
# your prompt — the LLM will pass it as the `region` argument.
AWS_DEFAULT_REGION=us-east-1

# Use a named profile from ~/.aws/credentials instead of explicit keys.
# AWS_PROFILE=my-readonly-profile

# Override the default LLM. Defaults to Haiku 4.5 (cheap, fast). Use Sonnet for
# harder reasoning.
# OPENKITE_MODEL=claude-sonnet-4-6

# SQLite path for thread checkpoints. Default: checkpoints/openkite.db
# OPENKITE_DB=checkpoints/openkite.db
